@{
    Layout = "_Layout";
}

<div class="p-6 flex justify-center">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 w-full max-w-md">

        <!-- Header -->
        <div class="p-5 border-b border-gray-200 dark:border-gray-600">
            <h3 class="text-lg font-DanaMedium text-gray-800 dark:text-gray-100">ایجاد حساب کاربری</h3>
        </div>

        <!-- Form -->
        <div class="p-5 space-y-4">
            <div class="flex flex-col gap-y-2">
                <label class="text-sm font-DanaMedium text-gray-700 dark:text-gray-300">نام</label>
                <input type="text" id="name" name="Name" placeholder="نام را وارد کنید"
                       class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600
                              bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100
                              focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
            </div>

            <div class="flex flex-col gap-y-2">
                <label class="text-sm font-DanaMedium text-gray-700 dark:text-gray-300">نام کاربری</label>
                <input type="text" id="userName" name="UserName" placeholder="نام کاربری را وارد کنید"
                       class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600
                              bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100
                              focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
            </div>

            <div class="flex flex-col gap-y-2">
                <label class="text-sm font-DanaMedium text-gray-700 dark:text-gray-300">رمز عبور</label>
                <input type="password" id="password" name="Password" placeholder="رمز عبور را وارد کنید"
                       class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600
                              bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100
                              focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
            </div>

            <div class="flex flex-col gap-y-2">
                <label class="text-sm font-DanaMedium text-gray-700 dark:text-gray-300">تکرار رمز عبور</label>
                <input type="password" id="rePassword" name="RePassword" placeholder="رمز عبور را تکرار کنید"
                       class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600
                              bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100
                              focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
            </div>

            <div class="flex flex-col gap-y-2">
                <label class="text-sm font-DanaMedium text-gray-700 dark:text-gray-300">نقش</label>
                <select id="Role" name="Role" asp-items="@ViewBag.Roles"
                        class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600
                               bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100
                               focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all">
                </select>
            </div>

           

            <button onclick="Registeruser()"
                    class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl
                           text-sm font-DanaMedium transition-all mt-2">
                ثبت نام
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function Registeruser() {
            Swal.fire({
                title: 'ثبت نام کاربر',
                text: "آیا می‌خواهید ثبت نام کاربر را انجام دهید؟",
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'بله، ثبت نام انجام شود',
                cancelButtonText: 'خیر'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "POST",
                        url: "Create",
                        contentType: 'application/x-www-form-urlencoded',
                        dataType: 'json',
                        data: {
                            Name: $("#name").val(),
                            UserName: $("#userName").val(),
                            RoleID: $("#Role").val(),
                            Password: $("#password").val(),
                            RePassword: $("#rePassword").val()
                        },
                        success: function (data) {
                            if (data.isSuccess) {
                                Swal.fire('موفق!', data.message, 'success')
                                    .then(() => location.href = "/Users/index");
                            } else {
                                Swal.fire('خطا!', data.message, 'error');
                            }
                        },
                        error: function (request) {
                            alert(request.responseText);
                        }
                    });
                }
            });
        }

        function Edituser() {
            $.ajax({
                type: "POST",
                url: "Edit",
                contentType: 'application/x-www-form-urlencoded',
                dataType: 'json',
                data: {
                    UserId: $("#Edit_UserId").val(),
                    FullName: $("#Edit_Fullname").val()
                },
                success: function (data) {
                    if (data.isSuccess) {
                        Swal.fire('موفق!', data.message, 'success').then(() => location.reload());
                    } else {
                        Swal.fire('هشدار!', data.message, 'warning');
                    }
                },
                error: function (request) {
                    alert(request.responseText);
                }
            });
            closeEditModal();
        }
    </script>
}

@section Modals {
    <div id="EditUser" class="fixed inset-0 z-50 hidden items-center justify-center">
        <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeEditModal()"></div>
        <div class="relative bg-white dark:bg-gray-800 rounded-2xl shadow-xl w-full max-w-md mx-4 z-10">

            <div class="flex items-center justify-between p-5 border-b border-gray-200 dark:border-gray-600">
                <h5 class="text-lg font-DanaMedium text-gray-800 dark:text-gray-100">ویرایش کاربر</h5>
                <button onclick="closeEditModal()"
                        class="p-1.5 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-500 dark:text-gray-300 transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <input type="hidden" id="Edit_UserId" />
                <div class="flex flex-col gap-y-2">
                    <label class="text-sm font-DanaMedium text-gray-700 dark:text-gray-300">نام و نام خانوادگی</label>
                    <input type="text" id="Edit_Fullname"
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600
                                          bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100
                                          focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
                </div>
            </div>

            <div class="flex items-center justify-end gap-x-3 p-5 border-t border-gray-200 dark:border-gray-600">
                <button onclick="closeEditModal()"
                        class="px-4 py-2 rounded-xl border border-gray-200 dark:border-gray-600
                                       text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-all text-sm font-DanaMedium">
                    بستن
                </button>
                <button onclick="Edituser()"
                        class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white transition-all text-sm font-DanaMedium">
                    اعمال تغییرات
                </button>
            </div>
        </div>
    </div>

    <script>
        function openEditModal() {
            const m = document.getElementById('EditUser');
            m.classList.remove('hidden');
            m.classList.add('flex');
        }

        function closeEditModal() {
            const m = document.getElementById('EditUser');
            m.classList.add('hidden');
            m.classList.remove('flex');
        }

        function ShowModalEdituser(UserId, fullName) {
            document.getElementById('Edit_UserId').value = UserId;
            document.getElementById('Edit_Fullname').value = fullName;
            openEditModal();
        }

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') closeEditModal();
        });
    </script>
}
@using KarinShop.Application.Services.Products.Queries.GetProductForAdmin
@addTagHelper *, LazZiya.TagHelpers
@model ListProductForAdminDto
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout2.cshtml";

    int Number = 1;
}

<style>

    * {
        direction : rtl;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Segoe UI', Tahoma, sans-serif;
        direction: rtl;
        text-align: right;
        background: #f5f6fa;
    }

    .wrapper {
        padding: 2rem 1rem;
    }
    }

    .page-header {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        padding: 2.5rem 2rem;
        text-align: center;
        border-radius: 12px;
        margin-bottom: 2rem;
    }

        .page-header h1 {
            color: #e2e8f0;
            font-size: 22px;
            font-weight: 500;
            margin-bottom: .5rem;
        }

    .breadcrumb-custom {
        color: #94a3b8;
        font-size: 13px;
    }

        .breadcrumb-custom .active {
            color: #7c9ec9;
        }

    .card {
        background: #fff;
        border: 1px solid #e8eaed;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1rem;
    }

    .card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
        padding-bottom: .75rem;
        border-bottom: 1px solid #e8eaed;
    }

    .section-title {
        font-size: 14px;
        font-weight: 500;
        color: #6b7280;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .section-title i {
            font-size: 16px;
            color: #3b82f6;
        }

    .btn-add {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 500;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
        text-decoration: none;
        transition: background .15s;
    }

        .btn-add:hover {
            background: #16a34a;
            color: #fff;
            text-decoration: none;
        }

        .btn-add i {
            font-size: 13px;
        }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    thead th {
        background: #f9fafb;
        color: #6b7280;
        font-weight: 500;
        padding: 10px 14px;
        text-align: right;
        border-bottom: 2px solid #e8eaed;
        white-space: nowrap;
    }

    tbody td {
        padding: 11px 14px;
        border-bottom: 1px solid #f0f0f0;
        color: #111827;
        vertical-align: middle;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover {
        background: #f9fafb;
    }

    .badge-yes {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .badge-no {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .btn-info-sm {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
        padding: 5px 12px;
        font-size: 12px;
        border-radius: 6px;
        cursor: pointer;
        font-family: inherit;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: background .15s;
    }

        .btn-info-sm:hover {
            background: #2563eb;
            color: #fff;
            text-decoration: none;
        }

    .btn-danger-sm {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
        padding: 5px 12px;
        font-size: 12px;
        border-radius: 6px;
        cursor: pointer;
        font-family: inherit;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: background .15s;
    }

        .btn-danger-sm:hover {
            background: #dc2626;
            color: #fff;
        }

    .actions-cell {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .price-cell {
        font-weight: 500;
        color: #374151;
        direction: ltr;
        text-align: right;
    }

        .price-cell span {
            font-size: 11px;
            color: #9ca3af;
            margin-right: 2px;
        }

    /* pagination */
    .pagination-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid #e8eaed;
    }

        /* override LazZiya paging styles */
        .pagination-wrapper ul {
            display: flex;
            gap: 4px;
            list-style: none;
            padding: 0;
            margin: 0;
            flex-wrap: wrap;
            justify-content: center;
        }

            .pagination-wrapper ul li a,
            .pagination-wrapper ul li span {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 34px;
                height: 34px;
                padding: 0 8px;
                border: 1px solid #e8eaed;
                border-radius: 8px;
                font-size: 13px;
                color: #374151;
                background: #fff;
                text-decoration: none;
                transition: all .15s;
            }

                .pagination-wrapper ul li a:hover {
                    background: #eff6ff;
                    border-color: #3b82f6;
                    color: #2563eb;
                }

            .pagination-wrapper ul li.active a,
            .pagination-wrapper ul li.active span {
                background: #3b82f6;
                border-color: #3b82f6;
                color: #fff;
            }

            .pagination-wrapper ul li.disabled a,
            .pagination-wrapper ul li.disabled span {
                color: #d1d5db;
                pointer-events: none;
            }

    .empty-row td {
        text-align: center;
        color: #9ca3af;
        padding: 2rem;
        font-size: 13px;
    }

    .inventory-low {
        color: #dc2626;
        font-weight: 600;
    }

    .inventory-ok {
        color: #16a34a;
    }

    .checkbox-wrapper-10 .tgl {
        display: none;
    }

        .checkbox-wrapper-10 .tgl,
        .checkbox-wrapper-10 .tgl:after,
        .checkbox-wrapper-10 .tgl:before,
        .checkbox-wrapper-10 .tgl *,
        .checkbox-wrapper-10 .tgl *:after,
        .checkbox-wrapper-10 .tgl *:before,
        .checkbox-wrapper-10 .tgl + .tgl-btn {
            box-sizing: border-box;
        }

            .checkbox-wrapper-10 .tgl::-moz-selection,
            .checkbox-wrapper-10 .tgl:after::-moz-selection,
            .checkbox-wrapper-10 .tgl:before::-moz-selection,
            .checkbox-wrapper-10 .tgl *::-moz-selection,
            .checkbox-wrapper-10 .tgl *:after::-moz-selection,
            .checkbox-wrapper-10 .tgl *:before::-moz-selection,
            .checkbox-wrapper-10 .tgl + .tgl-btn::-moz-selection,
            .checkbox-wrapper-10 .tgl::selection,
            .checkbox-wrapper-10 .tgl:after::selection,
            .checkbox-wrapper-10 .tgl:before::selection,
            .checkbox-wrapper-10 .tgl *::selection,
            .checkbox-wrapper-10 .tgl *:after::selection,
            .checkbox-wrapper-10 .tgl *:before::selection,
            .checkbox-wrapper-10 .tgl + .tgl-btn::selection {
                background: none;
            }

            .checkbox-wrapper-10 .tgl + .tgl-btn {
                outline: 0;
                display: block;
                width: 4em;
                height: 2em;
                position: relative;
                cursor: pointer;
                -webkit-user-select: none;
                -moz-user-select: none;
                -ms-user-select: none;
                user-select: none;
            }

                .checkbox-wrapper-10 .tgl + .tgl-btn:after,
                .checkbox-wrapper-10 .tgl + .tgl-btn:before {
                    position: relative;
                    display: block;
                    content: "";
                    width: 50%;
                    height: 100%;
                }

                .checkbox-wrapper-10 .tgl + .tgl-btn:after {
                    left: 0;
                }

                .checkbox-wrapper-10 .tgl + .tgl-btn:before {
                    display: none;
                }

            .checkbox-wrapper-10 .tgl:checked + .tgl-btn:after {
                left: 50%;
            }

    .checkbox-wrapper-10 .tgl-flip + .tgl-btn {
        padding: 2px;
        transition: all 0.2s ease;
        font-family: sans-serif;
        perspective: 100px;
    }

        .checkbox-wrapper-10 .tgl-flip + .tgl-btn:after,
        .checkbox-wrapper-10 .tgl-flip + .tgl-btn:before {
            display: inline-block;
            transition: all 0.4s ease;
            width: 100%;
            text-align: center;
            position: absolute;
            line-height: 2em;
            font-weight: bold;
            color: #fff;
            position: absolute;
            top: 0;
            left: 0;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
            border-radius: 4px;
        }

        .checkbox-wrapper-10 .tgl-flip + .tgl-btn:after {
            content: attr(data-tg-on);
            background: #02C66F;
            transform: rotateY(-180deg);
        }

        .checkbox-wrapper-10 .tgl-flip + .tgl-btn:before {
            background: #FF3A19;
            content: attr(data-tg-off);
        }

        .checkbox-wrapper-10 .tgl-flip + .tgl-btn:active:before {
            transform: rotateY(-20deg);
        }

    .checkbox-wrapper-10 .tgl-flip:checked + .tgl-btn:before {
        transform: rotateY(180deg);
    }

    .checkbox-wrapper-10 .tgl-flip:checked + .tgl-btn:after {
        transform: rotateY(0);
        left: 0;
        background: #7FC6A6;
    }

    .checkbox-wrapper-10 .tgl-flip:checked + .tgl-btn:active:after {
        transform: rotateY(20deg);
    }
</style>

<div class="wrapper">
    <div class="page-header">
        <h1>لیست محصولات</h1>
        <div class="breadcrumb-custom">
            <span>خانه</span> / <span class="active">محصولات</span>
        </div>
    </div>

    <div class="card">
        <div class="card-top">
            <div class="section-title">
                <i class="fas fa-box"></i> محصولات
            </div>
            <a href="/Admin/Products/addProduct" class="btn-add">
                <i class="fas fa-plus"></i> افزودن محصول
            </a>
        </div>

        <table>
            <thead>
                <tr>
                    <th>شماره</th>
                    <th>نام محصول</th>
                    <th>دسته‌بندی</th>
                    <th>برند</th>
                    <th>قیمت</th>
                    <th>موجودی</th>
                    <th>نمایش در سایت</th>
                    <th style="width:140px">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Products != null && Model.Products.Any())
                {
                    @foreach (var item in Model.Products)
                    {
                            <tr>
                              
                     
                        
                                <td>@Number</td>
                                <td><strong style="color:#111827">@item.Name</strong></td>
                                <td>@item.Category</td>
                                <td>@item.Brand</td>
                                <td class="price-cell">@item.Price.ToString("n0") <span>تومان</span></td>
                                <td class="@(item.Inventory <= 5 ? "inventory-low" : "inventory-ok")">@item.Inventory</td>
                                <td>
                                    @if (item.Displayed)
                                    {
                                        <span class="badge-yes"><i class="fas fa-check" style="font-size:10px"></i> بله</span>
                                    }
                                    else
                                    {
                                        <span class="badge-no"><i class="fas fa-times" style="font-size:10px"></i> خیر</span>

                                    }
                                </td>
                                <td>
                                    <div class="actions-cell">
                                        <a href="~/Admin/Products/Edit/@item.ID" class="btn-info-sm">
                                            <i class="fas fa-eye"></i> ویرایش
                                        </a>
                                        <a href="~/Admin/Products/detail/@item.ID" class="btn-info-sm">
                                            <i class="fas fa-eye"></i> جزئیات
                                        </a>

                                        <a class="btn-danger-sm btnDelete" data-id="@item.ID" href="RemoveProduct('@item.ID')">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                       
                        </tr>
                        Number++;
                    }
                }

                else
                {
                    <tr class="empty-row">
                        <td colspan="7">
                            <i class="fas fa-box-open" style="font-size:24px;display:block;margin-bottom:8px;color:#d1d5db"></i>
                            هیچ محصولی یافت نشد
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination-wrapper">
            <paging total-records="Model.RowCount"
                    page-no="Model.CurrentPage"
                    page-size="Model.PageSize"
                    show-prev-next="true"
                    show-total-pages="false"
                    show-total-records="false"
                    show-page-size-nav="true"
                    show-first-numbered-page="true"
                    show-last-numbered-page="true"
                    query-string-key-page-no="Page"
                    query-string-key-page-size="PageSize"
                    gap-size="2">
            </paging>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).on('click', '.btnDelete', function (e) {
            e.preventDefault();

            var productId = $(this).data('id');
            var row = $(this).closest('tr');

            Swal.fire({
                title: 'آیا مطمئن هستید؟',
                text: "این محصول برای همیشه حذف خواهد شد!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'بله، حذف شود',
                cancelButtonText: 'انصراف',
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6b7280',
                reverseButtons: true
            }).then(function (result) {
                if (result.isConfirmed) {

                    $.ajax({
                        url: '/Admin/Products/RemoveProduct',
                        type: 'POST',
                        data: { id: productId },
                        success: function (response) {
                            if (response.isSuccess) {
                                Swal.fire({
                                    title: 'حذف شد!',
                                    text: response.message || 'محصول با موفقیت حذف شد.',
                                    icon: 'success',
                                    confirmButtonText: 'باشه'
                                }).then(function () {
                                    row.fadeOut(300, function () {
                                        $(this).remove();
                                    });
                                });
                            } else {
                                Swal.fire({
                                    title: 'خطا',
                                    text: response.message || 'حذف محصول با مشکل مواجه شد.',
                                    icon: 'error',
                                    confirmButtonText: 'باشه'
                                });
                            }
                        },
                               error: function (xhr, status, errorThrown) {
            console.log('Status Code:', xhr.status);
            console.log('Response Text:', xhr.responseText);
            console.log('Error:', errorThrown);

            Swal.fire({
                title: 'خطا',
                text: 'کد خطا: ' + xhr.status + ' - برای جزئیات کنسول رو چک کن',
                icon: 'error',
                confirmButtonText: 'باشه'
            });
        }
                    });

                }
            });
        });
    </script>
}
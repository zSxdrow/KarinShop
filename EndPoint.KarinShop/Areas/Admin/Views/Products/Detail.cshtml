@using static KarinShop.Application.Services.Products.Queries.ProductDetailForAdmin.GetProductDetailForAdminServices
@model ProductDetailForAdminDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Detail";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<style>
    * {
        direction: rtl;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Segoe UI', Tahoma, sans-serif;
        direction: rtl;
        text-align: right;
        background: #f5f6fa;
    }

    .wrapper {
        padding: 2rem 1rem;
    }

    .page-header {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        padding: 2.5rem 2rem;
        text-align: center;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 10px 25px rgba(15, 52, 96, .25);
    }

        .page-header h1 {
            color: #e2e8f0;
            font-size: 22px;
            font-weight: 500;
            margin-bottom: .5rem;
        }

    .breadcrumb-custom {
        color: #94a3b8;
        font-size: 13px;
    }

        .breadcrumb-custom .active {
            color: #7c9ec9;
        }

    .card {
        background: #fff;
        border: 1px solid #e8eaed;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        transition: box-shadow .2s;
    }

        .card:hover {
            box-shadow: 0 4px 20px rgba(0,0,0,.05);
        }

    .section-title {
        font-size: 14px;
        font-weight: 500;
        color: #6b7280;
        margin-bottom: 1.25rem;
        padding-bottom: .75rem;
        border-bottom: 1px solid #e8eaed;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .section-title i {
            font-size: 16px;
            color: #3b82f6;
        }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .info-item {
        background: #f9fafb;
        border: 1px solid #e8eaed;
        border-radius: 10px;
        padding: 14px 16px;
        transition: border-color .15s, background .15s;
    }

        .info-item:hover {
            border-color: #3b82f6;
            background: #fff;
        }

        .info-item .info-label {
            font-size: 11px;
            color: #9ca3af;
            font-weight: 500;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

            .info-item .info-label i {
                color: #3b82f6;
                font-size: 12px;
            }

        .info-item .info-value {
            font-size: 15px;
            font-weight: 500;
            color: #111827;
        }

        .info-item.price .info-value {
            color: #16a34a;
        }

        .info-item.low-stock {
            border-color: #fecaca;
            background: #fef2f2;
        }

            .info-item.low-stock .info-value {
                color: #dc2626;
            }

    .desc-box {
        background: #f9fafb;
        border: 1px solid #e8eaed;
        border-radius: 10px;
        padding: 14px 16px;
        font-size: 14px;
        color: #374151;
        line-height: 1.8;
        white-space: pre-wrap; /* برای حفظ فاصله‌ها و اینترهای متن */
    }

    .two-col {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 1rem;
    }

    .feature-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .feature-row-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px;
        background: #f9fafb;
        border: 1px solid #e8eaed;
        border-radius: 8px;
    }

        .feature-row-item .feat-name {
            font-size: 13px;
            color: #6b7280;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .feature-row-item .feat-name i {
                color: #3b82f6;
                font-size: 12px;
            }

        .feature-row-item .feat-val {
            font-size: 13px;
            color: #111827;
            font-weight: 500;
        }

    .images-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 12px;
    }

    .img-card {
        position: relative;
        border: 1px solid #e8eaed;
        border-radius: 10px;
        overflow: hidden;
        background: #f9fafb;
        transition: border-color .15s, box-shadow .15s;
    }

        .img-card:hover {
            border-color: #3b82f6;
            box-shadow: 0 2px 12px rgba(59,130,246,.15);
        }

        .img-card a {
            display: block;
        }

        .img-card img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            display: block;
        }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f9fafb;
        border: 1px solid #e8eaed;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 13px;
        color: #374151;
        text-decoration: none;
        font-family: inherit;
        cursor: pointer;
        transition: background .15s;
        margin-bottom: 1.5rem;
    }

        .btn-back:hover {
            background: #f0f0f0;
            text-decoration: none;
            color: #111827;
        }

    @@media (max-width: 768px) {
        .info-grid

    {
        grid-template-columns: 1fr 1fr;
    }

    .two-col {
        grid-template-columns: 1fr;
    }

    }

    @@media (max-width: 480px) {
        .info-grid

    {
        grid-template-columns: 1fr;
    }

    }
</style>

<div class="wrapper">
    <div class="page-header">
        <h1>جزئیات محصول</h1>
        <div class="breadcrumb-custom">
            <span>خانه</span> / <span>محصولات</span> / <span class="active">@Model.Name</span>
        </div>
    </div>

    <a href="/Admin/Products/Index" class="btn-back">
        <i class="fas fa-arrow-right"></i> بازگشت به لیست
    </a>

    <div class="card">
        <div class="section-title">
            <i class="fas fa-box"></i> اطلاعات محصول
        </div>

        <div class="info-grid">
            <div class="info-item">
                <div class="info-label"><i class="fas fa-tag"></i> نام محصول</div>
                <div class="info-value">
                    @Model.Name
                </div>
            </div>
            <div class="info-item">
                <div class="info-label"><i class="fas fa-industry"></i> برند</div>
                <div class="info-value">
                    @Model.Brand
                </div>
            </div>
            <div class="info-item">
                <div class="info-label"><i class="fas fa-folder"></i> دسته‌بندی</div>
                <div class="info-value">
                    @(Model.Category ?? "ثبت نشده")
                </div>
            </div>
            <div class="info-item price">
                <div class="info-label"><i class="fas fa-coins"></i> قیمت</div>
                <div class="info-value">
                    @Model.Price.ToString("N0")
                    <span style="font-size:11px;color:#9ca3af;font-weight:400;margin-right:4px;">تومان</span>
                </div>
            </div>
            <div class="info-item @(Model.Inventory <= 5 ? "low-stock" : "")">
                <div class="info-label"><i class="fas fa-cubes"></i> موجودی</div>
                <div class="info-value">
                    @Model.Inventory <span style="font-size:12px;color:#6b7280;font-weight:normal;margin-right:4px;">عدد</span>
                </div>
            </div>
            <div class="info-item">
                <div class="info-label"><i class="fas fa-eye"></i> نمایش در سایت</div>
                <div class="info-value" style="margin-top: 4px;">
                    @if (Model.Displayed)
                    {
                        <span class="px-3 py-1 bg-green-500 text-white rounded-lg text-xs font-DanaMedium">
                            فعال
                        </span>
                    }
                    else
                    {
                        <span class="px-3 py-1 bg-red-500 text-white rounded-lg text-xs font-DanaMedium">
                            غیر فعال
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="info-label" style="margin-bottom:6px;display:flex;align-items:center;gap:5px">
            <i class="fas fa-align-right" style="color:#3b82f6;font-size:12px"></i> توضیحات
        </div>
        <div class="desc-box">
            @Model.Description
        </div>
    </div>

    <div class="two-col">
        <div class="card">
            <div class="section-title">
                <i class="fas fa-list"></i> ویژگی‌ها
            </div>
            <div class="feature-list">
                @if (Model.Features != null && Model.Features.Any())
                {
                    @foreach (var item in Model.Features)
                    {
                        <div class="feature-row-item">
                            <span class="feat-name"><i class="fas fa-circle" style="font-size:6px"></i> @item.DisplayName</span>
                            <span class="feat-val">@item.Value</span>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align:center;color:#9ca3af;font-size:13px;padding:1.5rem">
                        <i class="fas fa-list" style="font-size:24px;display:block;margin-bottom:8px;color:#d1d5db"></i>
                        ویژگی‌ای ثبت نشده
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="section-title">
                <i class="fas fa-images"></i> تصاویر محصول
            </div>
            @if (Model.Images != null && Model.Images.Any())
            {
                <div class="images-grid" id="imagesGrid">
                    @foreach (var item in Model.Images)
                    {
                        <div class="img-card" data-image-id="@item.ID">
                            <a target="_blank" href="~/@item.Src">
                                <img src="~/@item.Src" alt="تصویر محصول">
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align:center;color:#9ca3af;font-size:13px;padding:2rem" id="noImagesMsg">
                    <i class="fas fa-image" style="font-size:32px;display:block;margin-bottom:8px;color:#d1d5db"></i>
                    تصویری آپلود نشده
                </div>
            }
        </div>
    </div>
</div>
    @using static KarinShop.Application.Services.Products.Queries.ProductDetailForAdmin.GetProductDetailForAdminServices
    @model ProductDetailForAdminDto
    @addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
    @{
        ViewData["Title"] = "ویرایش محصول";
        Layout = "~/Views/Shared/_Layout2.cshtml";
    }

    <style>


        .wrapper {
            padding: 2rem 1rem;
        }

        .page-header {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            padding: 2.5rem 2rem;
            text-align: center;
            border-radius: 12px;
            margin-bottom: 2rem;
            box-shadow: 0 10px 25px rgba(15, 52, 96, .25);
        }

            .page-header h1 {
                color: #e2e8f0;
                font-size: 22px;
                font-weight: 500;
                margin-bottom: .5rem;
            }

        .breadcrumb-custom {
            color: #94a3b8;
            font-size: 13px;
        }

            .breadcrumb-custom .active {
                color: #7c9ec9;
            }

        .card {
            background: #fff;
            border: 1px solid #e8eaed;
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            transition: box-shadow .2s;
        }

            .card:hover {
                box-shadow: 0 4px 20px rgba(0,0,0,.05);
            }

        .section-title {
            font-size: 14px;
            font-weight: 500;
            color: #6b7280;
            margin-bottom: 1.25rem;
            padding-bottom: .75rem;
            border-bottom: 1px solid #e8eaed;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .section-title i {
                font-size: 16px;
                color: #3b82f6;
            }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .info-item {
            background: #f9fafb;
            border: 1px solid #e8eaed;
            border-radius: 10px;
            padding: 14px 16px;
            transition: border-color .15s, background .15s;
        }

            .info-item:hover {
                border-color: #3b82f6;
                background: #fff;
            }

            .info-item .info-label {
                font-size: 11px;
                color: #9ca3af;
                font-weight: 500;
                margin-bottom: 6px;
                display: flex;
                align-items: center;
                gap: 5px;
            }

                .info-item .info-label i {
                    color: #3b82f6;
                    font-size: 12px;
                }

            .info-item .info-value {
                font-size: 15px;
                font-weight: 500;
                color: #111827;
            }

            .info-item.price .info-value {
                color: #16a34a;
            }

            .info-item.low-stock {
                border-color: #fecaca;
                background: #fef2f2;
            }

                .info-item.low-stock .info-value {
                    color: #dc2626;
                }

        .desc-box {
            background: #f9fafb;
            border: 1px solid #e8eaed;
            border-radius: 10px;
            padding: 14px 16px;
            font-size: 14px;
            color: #374151;
            line-height: 1.8;
            white-space: pre-wrap;
        }

        .two-col {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 1rem;
        }

        .feature-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .feature-row-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 14px;
            background: #f9fafb;
            border: 1px solid #e8eaed;
            border-radius: 8px;
        }

            .feature-row-item .feat-name {
                font-size: 13px;
                color: #6b7280;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 6px;
            }

                .feature-row-item .feat-name i {
                    color: #3b82f6;
                    font-size: 12px;
                }

            .feature-row-item .feat-val {
                font-size: 13px;
                color: #111827;
                font-weight: 500;
            }

        .images-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 12px;
        }

        .img-card {
            position: relative;
            border: 1px solid #e8eaed;
            border-radius: 10px;
            overflow: hidden;
            background: #f9fafb;
            transition: border-color .15s, box-shadow .15s;
        }

            .img-card:hover {
                border-color: #3b82f6;
                box-shadow: 0 2px 12px rgba(59,130,246,.15);
            }

            .img-card a {
                display: block;
            }

            .img-card img {
                width: 100%;
                height: 160px;
                object-fit: cover;
                display: block;
            }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #f9fafb;
            border: 1px solid #e8eaed;
            border-radius: 8px;
            padding: 8px 16px;
            font-size: 13px;
            color: #374151;
            text-decoration: none;
            font-family: inherit;
            cursor: pointer;
            transition: background .15s;
            margin-bottom: 1.5rem;
        }

            .btn-back:hover {
                background: #f0f0f0;
                text-decoration: none;
                color: #111827;
            }

        @@media (max-width: 768px) {
            .info-grid {
                grid-template-columns: 1fr 1fr;
            }

            .two-col {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 480px) {
            .info-grid {
                grid-template-columns: 1fr;
            }
        }

        /* --- بخش افزودن ویژگی --- */
        .feature-add-row {
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            gap: 8px;
            align-items: end;
            margin-bottom: 1.25rem;
        }

        .btn-add-feature {
            background: #f0fdf4;
            color: #16a34a;
            border: 1px solid #bbf7d0;
            padding: 10px 18px;
            font-size: 14px;
            font-weight: 500;
            border-radius: 8px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: inherit;
            transition: background .15s;
            white-space: nowrap;
        }

            .btn-add-feature:hover {
                background: #16a34a;
                color: #fff;
            }



        .bauble_box .bauble_label {
            background-color: #c22;
            background-position: 62px 5px;
            background-repeat: no-repeat;
            background-size: auto 5px;
            border: 0;
            border-radius: 50px;
            box-shadow: inset 0 10px 20px rgba(0,0,0,.4), 0 -1px 0px rgba(0,0,0,.2), inset 0 -1px 0px #fff;
            cursor: pointer;
            display: inline-block;
            font-size: 0;
            height: 40px;
            position: relative;
            -webkit-transition: all 500ms ease;
            transition: all 500ms ease;
            width: 90px;
        }

            .bauble_box .bauble_label:before {
                background-color: rgba(255,255,255,.2);
                background-position: 0 0;
                background-repeat: repeat;
                background-size: 30% auto;
                border-radius: 50%;
                box-shadow: inset 0 -5px 25px #500, 0 10px 20px rgba(0,0,0,.4);
                content: '';
                display: block;
                height: 30px;
                left: 5px;
                position: absolute;
                top: 6px;
                -webkit-transition: all 500ms ease;
                transition: all 500ms ease;
                width: 30px;
                z-index: 2;
            }

        .bauble_box input.bauble_input {
            opacity: 0;
            z-index: 0;
        }

            .bauble_box input.bauble_input:checked + .bauble_label {
                background: #2c2;
            }

                .bauble_box input.bauble_input:checked + .bauble_label:before {
                    background-position: 150% 0;
                    box-shadow: inset 0 -5px 25px #050, 0 10px 20px rgba(0,0,0,.4);
                    left: calc( 100% - 35px );
                }

        body {
            font-family: 'Segoe UI', Tahoma, sans-serif;
            background: #f4f7f6;
            color: #2d3748;
        }

        .edit-container {
            max-width: 1000px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .edit-header {
            background: linear-gradient(135deg, #2b6cb0 0%, #2c5282 100%);
            color: #fff;
            padding: 2rem;
            border-radius: 12px 12px 0 0;
            text-align: center;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }

            .edit-header h1 {
                font-size: 1.5rem;
                font-weight: 600;
            }

        .edit-body {
            background: #fff;
            padding: 2.5rem;
            border-radius: 0 0 12px 12px;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05);
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

            .input-group label {
                font-size: 0.95rem;
                color: #4a5568;
                font-weight: 500;
            }

        .form-control {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid #cbd5e0;
            border-radius: 8px;
            font-family: inherit;
            font-size: 1rem;
            color: #1a202c;
            background: #f8fafc;
            transition: all 0.2s ease;
            outline: none;
        }

            .form-control:focus {
                border-color: #3182ce;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(49, 130, 206, 0.15);
            }

        textarea.form-control {
            resize: vertical;
            min-height: 140px;
            line-height: 1.6;
        }

        .action-buttons {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 1rem;
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid #e2e8f0;
        }

        .btn {
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            font-family: inherit;
            font-weight: 500;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .btn-primary {
            background: #3182ce;
            color: #fff;
        }

            .btn-primary:hover {
                background: #2b6cb0;
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(49, 130, 206, 0.3);
            }

        .btn-secondary {
            background: #edf2f7;
            color: #4a5568;
        }

            .btn-secondary:hover {
                background: #e2e8f0;
                color: #2d3748;
            }

        @@media (max-width: 640px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                flex-direction: column-reverse;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }
        }
    </style>

    <div class="edit-container">
        <div class="edit-header">
            <h1>ویرایش محصول: @Model.Name</h1>
        </div>

        <div class="edit-body">
            <input type="hidden" id="productId" value="@Model.ID" />

            <div class="form-grid">
                <div class="input-group">
                    <label>نام محصول</label>
                    <input type="text" id="productName" class="form-control" value="@Model.Name" />
                </div>

                <div class="input-group">
                    <label>برند</label>
                    <input type="text" id="productBrand" class="form-control" value="@Model.Brand" />
                </div>

                <div class="input-group">
                    <label>دسته‌بندی</label>
                    <select id="categoryProduct" class="form-control" asp-items="@ViewBag.Categories">
                    </select>
                </div>

                <div class="input-group">
                    <label>قیمت (تومان)</label>
                    <input type="number" id="productPrice" class="form-control" value="@Model.Price" />
                </div>

                <div class="input-group">
                    <label>موجودی</label>
                    <input type="number" id="productInventory" class="form-control" value="@Model.Inventory" />
                </div>
            </div>

            <div class="input-group">
                <label>توضیحات</label>
                <textarea id="productDescription" class="form-control">@Model.Description</textarea>
            </div>

            <div class="input-group">
                <label>نمایش دادن :</label>
                @if (Model.Displayed)
                {
                    <div class="bauble_box">
                        <input class="bauble_input" id="bauble_check" name="bauble" type="checkbox" checked>
                        <label class="bauble_label" for="bauble_check">Toggle</label>
                    </div>
                }
                else
                {
                    <div class="bauble_box">
                        <input class="bauble_input" id="bauble_check" name="bauble" type="checkbox">
                        <label class="bauble_label" for="bauble_check">Toggle</label>
                    </div>
                }

                <!-- بخش افزودن ویژگی جدید -->
                <div class="feature-add-row">
                    <div class="input-group" style="margin:0">
                        <label>نام ویژگی</label>
                        <input class="form-control" type="text" id="txtDisplayName" placeholder="مثلاً: رنگ">
                    </div>
                    <div class="input-group" style="margin:0">
                        <label>مقدار</label>
                        <input class="form-control" type="text" id="txtValue" placeholder="مثلاً: مشکی">
                    </div>
                    <button type="button" class="btn-add-feature" id="btnAddFeatures">
                        <i class="fas fa-plus"></i> افزودن
                    </button>
                </div>

                <div id="featuresList">
                    @if (Model.Features != null && Model.Features.Any())
                    {
                        @foreach (var item in Model.Features)
                        {
                            <div class="feature-row-item">
                                <span class="feat-name"><i class="fas fa-circle" style="font-size:6px"></i> @item.DisplayName</span>
                                <span class="feat-val">@item.Value</span>
                                <button style="background-color:red;width:60px; height:35px; color:aliceblue;border-radius:5px" onclick="RemoveFeature(@item.ID)">حذف</button>
                            </div>
                        }
                    }
                    else
                    {
                        <div id="emptyFeaturesMsg" style="text-align:center;color:#9ca3af;font-size:13px;padding:1.5rem">
                            <i class="fas fa-list" style="font-size:24px;display:block;margin-bottom:8px;color:#d1d5db"></i>
                            ویژگی‌ای ثبت نشده
                        </div>
                    }
                </div>
            </div>
            @if (Model.Images != null && Model.Images.Any())
            {
                <div class="images-grid" id="imagesGrid">
                    @foreach (var item in Model.Images)
                    {
                        <div class="img-card" data-image-id="@item.ID">
                            <a target="_blank" href="~/@item.Src">
                                <img src="~/@item.Src" alt="تصویر محصول">
                            </a>
                            <button onclick="RemoveImage(@item.ID)" class="btn btn-danger" style="color:aliceblue;background-color:red;width:75px;height:50px;font-weight:500;margin:auto">حذف </button>
                        </div>
                    }
                    <div class="card">
                        <div class="section-title"><i class="fas fa-images"></i> تصاویر محصول</div>
                        <label class="btn-file" for="imagesProduct">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <span style="font-weight:500;color:#374151" id="uploadLabel">آپلود تصاویر</span>
                            <span id="uploadSub">کلیک کنید یا فایل را اینجا رها کنید</span>
                        </label>
                        <input type="file" id="imagesProduct" multiple accept="image/*">
                    <button onclick="AddImage()" class="btn btn-danger" style="color:aliceblue;background-color:royalblue;width:75px;height:50px;font-weight:500;margin:auto">
                            افزودن عکس
                        </button>

                    </div>
                </div>
            }
            else
            {
                <div style="text-align:center;color:#9ca3af;font-size:13px;padding:2rem" id="noImagesMsg">
                    <i class="fas fa-image" style="font-size:32px;display:block;margin-bottom:8px;color:#d1d5db"></i>
                    تصویری آپلود نشده
                </div>
            }

            <div class="action-buttons">
                <a href="/Admin/Products/Index" class="btn btn-secondary">انصراف و بازگشت</a>
                <button type="button" class="btn btn-primary" onclick="saveProduct()">
                    <i class="fas fa-save"></i> ذخیره اطلاعات
                </button>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            function saveProduct() {
                Swal.fire({
                    title: 'ویرایش محصول',
                    text: "آیا از ذخیره تغییرات مطمئن هستید؟",
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'بله، ذخیره شود',
                    cancelButtonText: 'خیر'
                }).then((result) => {
                    if (result.value) {
                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("Edit", "Products")',
                            contentType: 'application/x-www-form-urlencoded',
                            dataType: 'json',
                            data: {
                                ID: '@ViewBag.ID',
                                Name: $("#productName").val(),
                                Brand: $("#productBrand").val(),
                                Description: $("#productDescription").val(),
                                CategoryID: $("#categoryProduct").val(),
                                Price: $("#productPrice").val(),
                                Inventory: $("#productInventory").val(),
                                Displayed: $("#bauble_check").prop("checked"),
                            },
                            success: function (data) {
                                if (data.isSuccess) {
                                    Swal.fire('موفق!', data.message, 'success')
                                        .then(() => location.href = "/Admin/Products/Index");
                                } else {
                                    Swal.fire('خطا!', data.message, 'error');
                                }
                            },
                            error: function (request) {
                                Swal.fire('خطا!', 'مشکلی در ارتباط با سرور پیش آمد.', 'error');
                            }
                        });
                    }
                });
            }

            // --- افزودن ویژگی جدید ---
            $("#btnAddFeatures").on("click", function () {
                var displayName = $("#txtDisplayName").val().trim();
                var value = $("#txtValue").val().trim();

                if (displayName === "" || value === "") {
                    Swal.fire('هشدار!', 'نام و مقدار ویژگی را وارد کنید', 'warning');
                    return;
                }

                var postData = {
                    ProductID: @ViewBag.ID,
                    DisplayName: displayName,
                    Value: value
                };

                $.ajax({
                    type: "POST",
                    url: "/Admin/Products/AddNewFeature",
                    contentType: 'application/x-www-form-urlencoded',
                    dataType: 'json',
                    data: postData,
                    success: function (data) {
                        if (data.isSuccess) {
                            Swal.fire('موفق!', data.message, 'success').then(function () {
                                location.reload();
                            });
                        } else {
                            Swal.fire('هشدار!', data.message, 'warning');
                        }
                    },
                    error: function () {
                        Swal.fire('خطا!', 'مشکلی در ارتباط با سرور پیش آمد.', 'error');
                    }
                });
            });

               function RemoveFeature(ID) {
                swal.fire({
                    title: 'حذف ویژگی',
                    text: "کاربر گرامی از حذف ویژگی مطمئن هستید؟",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#7cacbe',
                    confirmButtonText: 'بله ، ویژگی حذف شود',
                    cancelButtonText: 'خیر'
                }).then((result) => {
                    if (result.value) {
                        var postData = {
                            'ID': ID,
                        };

                        $.ajax({
                            contentType: 'application/x-www-form-urlencoded',
                            dataType: 'json',
                            type: "POST",
                            url: "/Admin/Products/RemoveFeature",
                            data: postData,
                            success: function (data) {
                                if (data.isSuccess == true) {
                                    swal.fire(
                                        'موفق!',
                                        data.message,
                                        'success'
                                    ).then(function (isConfirm) {
                                        location.reload();
                                    });
                                }
                                else {
                                    swal.fire(
                                        'هشدار!',
                                        data.message,
                                        'warning'
                                    );
                                }
                            },
                            error: function (request, status, error) {
                                alert(request.responseText);
                            }
                        });
                    }
                });
                }
                function RemoveImage(ID) {
                swal.fire({
                    title: 'حذف تصویر',
                    text: "کاربر گرامی از حذف تصویر مطمئن هستید؟",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#7cacbe',
                    confirmButtonText: 'بله ، تصویر حذف شود',
                    cancelButtonText: 'خیر'
                }).then((result) => {
                    if (result.value) {
                        var postData = {
                            'ImageID': ID,
                        };

                        $.ajax({
                            contentType: 'application/x-www-form-urlencoded',
                            dataType: 'json',
                            type: "POST",
                            url: "/Admin/Products/RemoveImage",
                            data: postData,
                            success: function (data) {
                                if (data.isSuccess == true) {
                                    swal.fire(
                                        'موفق!',
                                        data.message,
                                        'success'
                                    ).then(function (isConfirm) {
                                        location.reload();
                                    });
                                }
                                else {
                                    swal.fire(
                                        'هشدار!',
                                        data.message,
                                        'warning'
                                    );
                                }
                            },
                            error: function (request, status, error) {
                                alert(request.responseText);
                            }
                        });
                    }
                });
                }
            function AddImage() {
                var fileInput = document.getElementById("imagesProduct");

                if (fileInput.files.length === 0) {
                    Swal.fire('هشدار!', 'لطفاً حداقل یک تصویر انتخاب کنید', 'warning');
                    return;
                }

                Swal.fire({
                    title: 'افزودن تصویر',
                    text: "آیا از آپلود تصاویر انتخابی مطمئن هستید؟",
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'بله ، آپلود شود',
                    cancelButtonText: 'خیر'
                }).then((result) => {
                    if (result.value) {
                        var formData = new FormData();

                        for (var i = 0; i < fileInput.files.length; i++) {
                            formData.append("file", fileInput.files[i]);
                        }
                        formData.append("ProductID", @ViewBag.ID);
                        formData.append("FolerName", "");

                        $.ajax({
                            type: "POST",
                            url: "/Admin/Products/AddProductImage",
                            data: formData,
                            contentType: false,
                            processData: false,
                            dataType: 'json',
                            success: function (data) {
                                if (data.isSuccess) {
                                    Swal.fire('موفق!', data.message, 'success').then(function () {
                                        location.reload();
                                    });
                                } else {
                                    Swal.fire('خطا!', data.message, 'error');
                                }
                            },
                            error: function () {
                                Swal.fire('خطا!', 'مشکلی در ارتباط با سرور پیش آمد.', 'error');
                            }
                        });
                    }
                });
            }
        
        </script>
    }

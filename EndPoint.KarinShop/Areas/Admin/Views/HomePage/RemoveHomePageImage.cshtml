@using KarinShop.Application.Services.HomePage.Command.RemoveHomePageImage
@using KarinShop.Application.Services.HomePage.Query.GetHomePageImages

@{
    ViewData["Title"] = "RemoveHomePageImage";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
@model List<HomePageImageDto>;
@{
    int Number = 1;
}

<style>

    * {
        direction: rtl;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Segoe UI', Tahoma, sans-serif;
        direction: rtl;
        text-align: right;
        background: #f5f6fa;
    }

    .wrapper {
        padding: 2rem 1rem;
    }

    }

    .page-header {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        padding: 2.5rem 2rem;
        text-align: center;
        border-radius: 12px;
        margin-bottom: 2rem;
    }

        .page-header h1 {
            color: #e2e8f0;
            font-size: 22px;
            font-weight: 500;
            margin-bottom: .5rem;
        }

    .breadcrumb-custom {
        color: #94a3b8;
        font-size: 13px;
    }

        .breadcrumb-custom .active {
            color: #7c9ec9;
        }

    .card {
        background: #fff;
        border: 1px solid #e8eaed;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1rem;
    }

    .card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
        padding-bottom: .75rem;
        border-bottom: 1px solid #e8eaed;
    }

    .section-title {
        font-size: 14px;
        font-weight: 500;
        color: #6b7280;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .section-title i {
            font-size: 16px;
            color: #3b82f6;
        }

    .btn-add {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 500;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: inherit;
        text-decoration: none;
        transition: background .15s;
    }

        .btn-add:hover {
            background: #16a34a;
            color: #fff;
            text-decoration: none;
        }

        .btn-add i {
            font-size: 13px;
        }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    thead th {
        background: #f9fafb;
        color: #6b7280;
        font-weight: 500;
        padding: 10px 14px;
        text-align: right;
        border-bottom: 2px solid #e8eaed;
        white-space: nowrap;
    }

    tbody td {
        padding: 11px 14px;
        border-bottom: 1px solid #f0f0f0;
        color: #111827;
        vertical-align: middle;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover {
        background: #f9fafb;
    }

    .badge-yes {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .badge-no {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .btn-info-sm {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
        padding: 5px 12px;
        font-size: 12px;
        border-radius: 6px;
        cursor: pointer;
        font-family: inherit;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: background .15s;
    }

        .btn-info-sm:hover {
            background: #2563eb;
            color: #fff;
            text-decoration: none;
        }

    .btn-danger-sm {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
        padding: 5px 12px;
        font-size: 12px;
        border-radius: 6px;
        cursor: pointer;
        font-family: inherit;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: background .15s;
    }

        .btn-danger-sm:hover {
            background: #dc2626;
            color: #fff;
        }

    .actions-cell {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .price-cell {
        font-weight: 500;
        color: #374151;
        direction: ltr;
        text-align: right;
    }

        .price-cell span {
            font-size: 11px;
            color: #9ca3af;
            margin-right: 2px;
        }

    /* pagination */
    .pagination-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid #e8eaed;
    }

        /* override LazZiya paging styles */
        .pagination-wrapper ul {
            display: flex;
            gap: 4px;
            list-style: none;
            padding: 0;
            margin: 0;
            flex-wrap: wrap;
            justify-content: center;
        }

            .pagination-wrapper ul li a,
            .pagination-wrapper ul li span {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 34px;
                height: 34px;
                padding: 0 8px;
                border: 1px solid #e8eaed;
                border-radius: 8px;
                font-size: 13px;
                color: #374151;
                background: #fff;
                text-decoration: none;
                transition: all .15s;
            }

                .pagination-wrapper ul li a:hover {
                    background: #eff6ff;
                    border-color: #3b82f6;
                    color: #2563eb;
                }

            .pagination-wrapper ul li.active a,
            .pagination-wrapper ul li.active span {
                background: #3b82f6;
                border-color: #3b82f6;
                color: #fff;
            }

            .pagination-wrapper ul li.disabled a,
            .pagination-wrapper ul li.disabled span {
                color: #d1d5db;
                pointer-events: none;
            }

    .empty-row td {
        text-align: center;
        color: #9ca3af;
        padding: 2rem;
        font-size: 13px;
    }

    .inventory-low {
        color: #dc2626;
        font-weight: 600;
    }

    .inventory-ok {
        color: #16a34a;
    }

    .checkbox-wrapper-10 .tgl {
        display: none;
    }

        .checkbox-wrapper-10 .tgl,
        .checkbox-wrapper-10 .tgl:after,
        .checkbox-wrapper-10 .tgl:before,
        .checkbox-wrapper-10 .tgl *,
        .checkbox-wrapper-10 .tgl *:after,
        .checkbox-wrapper-10 .tgl *:before,
        .checkbox-wrapper-10 .tgl + .tgl-btn {
            box-sizing: border-box;
        }

            .checkbox-wrapper-10 .tgl::-moz-selection,
            .checkbox-wrapper-10 .tgl:after::-moz-selection,
            .checkbox-wrapper-10 .tgl:before::-moz-selection,
            .checkbox-wrapper-10 .tgl *::-moz-selection,
            .checkbox-wrapper-10 .tgl *:after::-moz-selection,
            .checkbox-wrapper-10 .tgl *:before::-moz-selection,
            .checkbox-wrapper-10 .tgl + .tgl-btn::-moz-selection,
            .checkbox-wrapper-10 .tgl::selection,
            .checkbox-wrapper-10 .tgl:after::selection,
            .checkbox-wrapper-10 .tgl:before::selection,
            .checkbox-wrapper-10 .tgl *::selection,
            .checkbox-wrapper-10 .tgl *:after::selection,
            .checkbox-wrapper-10 .tgl *:before::selection,
            .checkbox-wrapper-10 .tgl + .tgl-btn::selection {
                background: none;
            }

            .checkbox-wrapper-10 .tgl + .tgl-btn {
                outline: 0;
                display: block;
                width: 4em;
                height: 2em;
                position: relative;
                cursor: pointer;
                -webkit-user-select: none;
                -moz-user-select: none;
                -ms-user-select: none;
                user-select: none;
            }

                .checkbox-wrapper-10 .tgl + .tgl-btn:after,
                .checkbox-wrapper-10 .tgl + .tgl-btn:before {
                    position: relative;
                    display: block;
                    content: "";
                    width: 50%;
                    height: 100%;
                }

                .checkbox-wrapper-10 .tgl + .tgl-btn:after {
                    left: 0;
                }

                .checkbox-wrapper-10 .tgl + .tgl-btn:before {
                    display: none;
                }

            .checkbox-wrapper-10 .tgl:checked + .tgl-btn:after {
                left: 50%;
            }

    .checkbox-wrapper-10 .tgl-flip + .tgl-btn {
        padding: 2px;
        transition: all 0.2s ease;
        font-family: sans-serif;
        perspective: 100px;
    }

        .checkbox-wrapper-10 .tgl-flip + .tgl-btn:after,
        .checkbox-wrapper-10 .tgl-flip + .tgl-btn:before {
            display: inline-block;
            transition: all 0.4s ease;
            width: 100%;
            text-align: center;
            position: absolute;
            line-height: 2em;
            font-weight: bold;
            color: #fff;
            position: absolute;
            top: 0;
            left: 0;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
            border-radius: 4px;
        }

        .checkbox-wrapper-10 .tgl-flip + .tgl-btn:after {
            content: attr(data-tg-on);
            background: #02C66F;
            transform: rotateY(-180deg);
        }

        .checkbox-wrapper-10 .tgl-flip + .tgl-btn:before {
            background: #FF3A19;
            content: attr(data-tg-off);
        }

        .checkbox-wrapper-10 .tgl-flip + .tgl-btn:active:before {
            transform: rotateY(-20deg);
        }

    .checkbox-wrapper-10 .tgl-flip:checked + .tgl-btn:before {
        transform: rotateY(180deg);
    }

    .checkbox-wrapper-10 .tgl-flip:checked + .tgl-btn:after {
        transform: rotateY(0);
        left: 0;
        background: #7FC6A6;
    }

    .checkbox-wrapper-10 .tgl-flip:checked + .tgl-btn:active:after {
        transform: rotateY(20deg);
    }
</style>

<div class="wrapper">
    <div class="page-header">
        <h1>لیست محصولات</h1>
        <div class="breadcrumb-custom">
            <span>خانه</span> / <span class="active">محصولات</span>
        </div>
    </div>

    <div class="card">
        <div class="card-top">
            <div class="section-title">
                <i class="fas fa-box"></i> محصولات
            </div>
            <a href="/Admin/HomePage/AddNewHomePageImage" class="btn-add">
                <i class="fas fa-plus"></i> افزودن اسلاید
            </a>
        </div>

        <table>
            <thead>
                <tr>
                    <th>شماره</th>
                    <th>تصویر</th>
                    <th>لینک</th>
                    <th>موقعیت در صفحه</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    @foreach (var item in Model)
                    {
                        <tr>



                            <td>@Number</td>
                            <td><img src="~/@item.Src" style="width:200px" /></td>
                            <td><strong style="color:#111827">@item.Link</strong></td>
                            <td>@item.imageLocation.ToString()</td>
                            <td>@item.Title</td>
                             <td>
                                <div class="actions-cell">
                                    <button onclick="DeleteSlide(@item.ID)" class="btn-danger-sm btnDelete">
                                        <i class="fas fa-eye"></i> حذف
                                    </button>
                                   </div>
                            </td>

                        </tr>
                        Number++;
                    }
                }

                else
                {
                    <tr class="empty-row">
                        <td colspan="7">
                            <i class="fas fa-box-open" style="font-size:24px;display:block;margin-bottom:8px;color:#d1d5db"></i>
                            هیچ محصولی یافت نشد
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination-wrapper">
            <paging total-records="Model.RowCount"
                    page-no="Model.CurrentPage"
                    page-size="Model.PageSize"
                    show-prev-next="true"
                    show-total-pages="false"
                    show-total-records="false"
                    show-page-size-nav="true"
                    show-first-numbered-page="true"
                    show-last-numbered-page="true"
                    query-string-key-page-no="Page"
                    query-string-key-page-size="PageSize"
                    gap-size="2">
            </paging>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function DeleteSlide(ID) { // نام پارامتر در تابع و postData یکسان باشد
              swal.fire({
                  title: 'حذف کاربر',
                  text: "کاربر گرامی از حذف کاربر مطمئن هستید؟",
                  icon: 'warning',
                  showCancelButton: true,
                  confirmButtonColor: '#d33',
                  cancelButtonColor: '#7cacbe',
                  confirmButtonText: 'بله ، کاربر حذف شود',
                  cancelButtonText: 'خیر'
              }).then((result) => {
                  if (result.value) {
                      var postData = {
                          'ID': ID, // پارامتر در کنترلر UserID است
                      };

                      $.ajax({
                          contentType: 'application/x-www-form-urlencoded',
                          dataType: 'json',
                          type: "POST",
                          url: "/Admin/HomePage/RemoveHomePageImage", 
                          data: postData,
                          success: function (data) {
                              if (data.isSuccess == true) {
                                  swal.fire(
                                      'موفق!',
                                      data.message,
                                      'success'
                                  ).then(function (isConfirm) {
                                      location.reload();
                                  });
                              }
                              else {
                                  swal.fire(
                                      'هشدار!',
                                      data.message,
                                      'warning'
                                  );
                              }
                          },
                          error: function (request, status, error) {
                              alert(request.responseText);
                          }
                      });
                  }
              })
          }
    </script>
}
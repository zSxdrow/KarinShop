@using KarinShop.Domain.Entities.HomePage
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "AddNewSlider";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
<!doctype html>
<body>
    <div class="p-6">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700">
            <!-- Header -->
            <div class="flex items-center p-5 border-b border-gray-200 dark:border-gray-600">
                <h4 class="text-lg font-DanaMedium text-gray-800 dark:text-gray-100">
                    اضافه کردن اسلایدر بندی جدید برای محصولات
                </h4>
            </div>
            <!-- Body -->
            <form method="post" enctype="multipart/form-data" id="addSliderForm">

                <div class="p-5">

                    <div class="flex flex-col gap-y-2 max-w-sm">
                        <label class="text-sm font-DanaMedium text-gray-700 dark:text-gray-300">
                            لینک اسلایدر
                        </label>
                        <input type="text" id="link" name="Link"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600
                              bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100
                              focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
                    </div>
                    <div class="flex flex-col gap-y-2 max-w-sm">
                        <label class="text-sm font-DanaMedium text-gray-700 dark:text-gray-300">
                            تصویر
                        </label>
                        <input type="file" name="File"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600
                              bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100
                              focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
                    </div>
                        <label class="text-sm font-DanaMedium text-gray-700 dark:text-gray-300">
                            موقعیت
                        </label>
                    <select name="location" asp-items="@Html.GetEnumSelectList<ImageLocation>()">
                            </select>
                   

                    <div class="flex flex-col gap-y-2 max-w-sm">
                        <label class="text-sm font-DanaMedium text-gray-700 dark:text-gray-300">
                           موضوع (اختیاری)
                        </label>
                        <input type="text" name="Title"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-600
                              bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100
                              focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" 
                               placeholder="مضوعی که میخواهید زیر تصویر به کاربر نمایش داده شود را وارد کنید"/>
                    </div>
                    <button type="submit"
                            class="mt-5 w-full max-w-sm px-4 py-2.5 bg-green-500 hover:bg-green-600
                           text-white rounded-xl text-sm font-DanaMedium transition-all">
                        افزودن اسلایدر
                    </button>
                </div>
            </form>
        </div>
    </div>

</body>

@section Scripts {
    <script>
        document.getElementById('addSliderForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const form = this;

            Swal.fire({
                title: 'مطمئنی؟',
                text: 'آیا از اضافه کردن این اسلایدر مطمئن هستید؟',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'بله، اضافه کن',
                cancelButtonText: 'انصراف',
                reverseButtons: true
            }).then((result) => {
                if (result.value) {
                    form.submit();
                }
            });
        });

        @if (TempData["IsSuccess"] != null)
        {
                    <text>
                    Swal.fire({
                        icon: '@(((bool)TempData["IsSuccess"]!) ? "success" : "error")',
                        title: '@(((bool)TempData["IsSuccess"]!) ? "موفق" : "خطا")',
                        text: '@Html.Raw(TempData["Message"])',
                        confirmButtonText: 'باشه'
                    });
                    </text>
        }
    </script>
}